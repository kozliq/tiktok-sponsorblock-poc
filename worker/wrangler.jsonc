// Мимо — база вшитой рекламы в TikTok. Cloudflare Worker + D1, бесплатный тариф.
// Подготовка: npx wrangler d1 create mimo  → вписать database_id ниже → npm run db:remote
// Секреты (любые длинные случайные строки, в чат не выводить):
//   npx wrangler secret put PEPPER    — соль для хэшей userID
//   npx wrangler secret put BOT_KEY   — пропуск бота Качалки (тот же ключ в MIMO_BOT_KEY на сервере)
// Деплой: npm run deploy (только из этой папки — wrangler берёт конфиг из текущей).
{
	"name": "mimo-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	// Адрес проверен 26.10.2026: в DNS его не было (NXDOMAIN), ни у кого не отняли.
	// wrangler с custom_domain ЗАБИРАЕТ адрес у другого воркера — деплоить только из этой папки.
	"routes": [{ "pattern": "mimo.flownote.cc", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mimo",
			"database_id": "YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	// Счётчики держит Cloudflare в памяти, адреса нигде не сохраняются.
	// Чтение: телефон листает ленту ~1 ролик в 5 с, с кэшем клиента хватает с запасом.
	"ratelimits": [
		{ "name": "READ_LIMIT", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
		{ "name": "WRITE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
	],
	// Журналы выключены: какие ролики смотрят люди, нигде не оседает.
	"observability": { "enabled": false },
	"vars": {
		"MAX_SEGMENT_MS": "60000",
		"CACHE_SECONDS": "60"
	}
}
